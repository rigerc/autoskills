{
  "name": "autoskills",
  "version": "0.4.1",
  "description": "Auto-detect and install the best AI agent skills for your project",
  "keywords": [
    "agent",
    "ai",
    "auto",
    "claude",
    "cli",
    "copilot",
    "cursor",
    "detect",
    "skills"
  ],
  "homepage": "https://autoskills.sh",
  "license": "CC-BY-NC-4.0",
  "author": "midudev",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/midudev/autoskills.git"
  },
  "bin": {
    "autoskills": "index.mjs"
  },
  "files": [
    "index.mjs",
    "dist/",
    "studio/",
    "docs/catalog.md",
    "skills-registry/index.json"
  ],
  "type": "module",
  "scripts": {
    "build": "tsc",
    "test": "node --test 'tests/*.test.ts'",
    "start": "node index.mjs",
    "dev": "node index.mjs",
    "ui": "node index.mjs ui",
    "validate:registry": "node --experimental-strip-types --disable-warning=ExperimentalWarning scripts/validate-registry.mjs",
    "prepublishOnly": "pnpm run validate:registry",
    "release": "node scripts/release.mjs",
    "sync:skills": "node --experimental-strip-types --disable-warning=ExperimentalWarning scripts/sync-skills.mjs",
    "discover:skills": "node --experimental-strip-types --disable-warning=ExperimentalWarning scripts/discover-autoskills.mjs",
    "discover:skills:interactive": "node --experimental-strip-types --disable-warning=ExperimentalWarning scripts/discover-autoskills.mjs --interactive",
    "discover:skills:batch": "node --experimental-strip-types --disable-warning=ExperimentalWarning scripts/discover-autoskills.mjs --no-interactive",
    "discover:skills:quality": "node --experimental-strip-types --disable-warning=ExperimentalWarning scripts/discover-autoskills.mjs --source both --sort stars --queries-per-tech 4 --pages 2 --recent-pages 2 --category-pages 2 --directory-searches 100 --skillsmd-pages 5 --skillsmd-searches 60 --details-limit 100 --verify-limit 120 --min-score 55 --max-per-tech 3 --cache --cache-ttl-minutes 360 --interactive",
    "discover:skills:jev": "node --experimental-strip-types --disable-warning=ExperimentalWarning scripts/discover-autoskills-jev.mjs"
  },
  "devDependencies": {
    "@anthropic-ai/sdk": "0.133.0",
    "@types/node": "22.20.5",
    "typescript": "7.0.2"
  },
  "engines": {
    "node": ">=22.6.0"
  }
}
